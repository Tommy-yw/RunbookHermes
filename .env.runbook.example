# RunbookHermes profile / model provider
HERMES_INFERENCE_PROVIDER=custom
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me

# Optional Runbook API model helper. Set RUNBOOK_MODEL_ENABLED=true only after you have a key.
RUNBOOK_MODEL_ENABLED=false
RUNBOOK_MODEL_PROVIDER=openai-compatible
RUNBOOK_MODEL_NAME=openrouter/auto
RUNBOOK_MODEL_BASE_URL=https://openrouter.ai/api/v1
RUNBOOK_MODEL_API_KEY=replace-me
RUNBOOK_MODEL_TEMPERATURE=0
RUNBOOK_MAX_TURNS=12

# Store
RUNBOOK_STORE_DIR=.runbook_hermes_store

# Backend switch
OBS_BACKEND=mock
DEPLOY_BACKEND=mock
TRACE_BACKEND=mock

# Prometheus
PROMETHEUS_BASE_URL=
PROMETHEUS_AUTH_TOKEN=
PROMETHEUS_TENANT=
PROMETHEUS_TIMEOUT_SECONDS=5

# Loki
LOKI_BASE_URL=
LOKI_AUTH_TOKEN=
LOKI_TENANT=
LOKI_TIMEOUT_SECONDS=5

# Trace
TRACE_BASE_URL=
TRACE_AUTH_TOKEN=
TRACE_PROVIDER_KIND=mock
TRACE_TIMEOUT_SECONDS=5

# Deploy / rollback
DEPLOY_API_BASE_URL=
DEPLOY_API_TOKEN=
DEPLOY_TIMEOUT_SECONDS=5
ROLLBACK_BACKEND_KIND=mock
ROLLOUT_APP_NAMESPACE=default

# Feishu / Lark
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_CALLBACK_BASE_URL=
FEISHU_BOT_WEBHOOK_URL=
FEISHU_BOT_SECRET=

# WeCom / 企业微信
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_CALLBACK_BASE_URL=
RUNBOOK_GATEWAY_STRICT_SECURITY=true
RUNBOOK_GATEWAY_ALLOW_UNSIGNED_CALLBACKS=false
RUNBOOK_GATEWAY_REPLAY_WINDOW_SECONDS=600

# Local payment demo / real observability mode.
# Keep these as mock until you start demo/payment_system/docker-compose.yml.
# OBS_BACKEND=real
# DEPLOY_BACKEND=demo_file
# TRACE_BACKEND=jaeger
# TRACE_PROVIDER_KIND=jaeger
# ROLLBACK_BACKEND_KIND=demo_file
# RUNBOOK_CONTROLLED_EXECUTION_ENABLED=true
# PROMETHEUS_BASE_URL=http://127.0.0.1:9090
# LOKI_BASE_URL=http://127.0.0.1:3100
# TRACE_BASE_URL=http://127.0.0.1:16686
# DEMO_DEPLOY_STATE_FILE=data/payment_demo/deployments.json
# DEMO_VERSION_FILE=data/payment_demo/runtime/payment-service-version.txt
# RUNBOOK_RECOVERY_VERIFY_WINDOW=2m
# RUNBOOK_RECOVERY_ERROR_RATE_THRESHOLD=0.02


# Controlled action executor shells. Non-rollback mutations are fail-closed until
# backend + operation allowlist + approved approval_id + second confirmation pass.
ACTION_EXECUTION_BACKEND=none
ACTION_EXECUTION_API_BASE_URL=
ACTION_EXECUTION_API_TOKEN=
ACTION_EXECUTION_TIMEOUT_SECONDS=5
ACTION_EXECUTION_ALLOWED_TYPES=
# Backward-compatible aliases also supported.
ACTION_EXECUTION_ALLOWED_OPERATIONS=scale_or_disable_coupon_path,adjust_rate_limit
# Backward-compatible alias also supported: ACTION_EXECUTION_ALLOWED_ACTIONS
ACTION_EXECUTION_REQUIRE_SECOND_CONFIRMATION=true
ACTION_EXECUTION_CONFIRMATION_TOKEN=CONFIRM_EXECUTE
ACTION_EXECUTION_AUDIT_LOG_FILE=.runbook_hermes_store/audit/actions.jsonl

# Self-evolving RunbookHermes memory
RUNBOOK_MEMORY_ENABLED=true
RUNBOOK_MEMORY_DIR=.runbook_hermes_store/memory
RUNBOOK_MEMORY_CONTEXT_LIMIT=6
RUNBOOK_MEMORY_HRR_DIM=1024
RUNBOOK_MEMORY_EXTERNAL_PROVIDER=none
RUNBOOK_MEMORY_EXTERNAL_MODE=tools
RUNBOOK_MEMORY_CONTEXT_CADENCE=1
RUNBOOK_MEMORY_INJECTION_FREQUENCY=first-turn

# Hermes official memory/skill integration bridge
RUNBOOK_MEMORY_BRIDGE_ENABLED=true
RUNBOOK_MEMORY_BRIDGE_PROVIDER_NAME=runbook_hermes
RUNBOOK_MEMORY_ROUTER_ENABLED=true
RUNBOOK_FEISHU_MEMORY_ROUTER_ENABLED=true
RUNBOOK_SKILL_PUBLISH_ENABLED=true
RUNBOOK_SKILL_PUBLISH_CATEGORY=runbooks/runbookhermes

# API auth. Enabled by default for production safety. For isolated local demos only, set RUNBOOK_API_DEMO_INSECURE=true or RUNBOOK_API_AUTH_ENABLED=false.
# Send either Authorization: Bearer <token> or X-Runbook-Token: <token>.
RUNBOOK_API_AUTH_ENABLED=true
RUNBOOK_API_TOKEN=
RUNBOOK_API_READ_ONLY_TOKEN=
RUNBOOK_API_AUTH_HEADER=x-runbook-token

# Citation RAG / knowledge base
RUNBOOK_RAG_ENABLED=true
RUNBOOK_RAG_DIR=.runbook_hermes_store/rag
RUNBOOK_RAG_CHUNK_CHARS=1200
RUNBOOK_RAG_CHUNK_OVERLAP=160
RUNBOOK_RAG_CONTEXT_LIMIT=5
RUNBOOK_RAG_INGEST_ROOTS=docs,skills/runbooks,profiles/runbook-hermes,data/runbook_samples,data/runbook_mock,data/runbook_benchmark
# Backward-compatible alias also supported: RUNBOOK_RAG_ALLOWED_ROOTS
RUNBOOK_RAG_EMBEDDING_MODEL=local-hash-embedding-v1
RUNBOOK_RAG_EMBEDDING_DIM=256
RUNBOOK_RAG_FRESHNESS_HALF_LIFE_DAYS=180
RUNBOOK_RAG_DEFAULT_PERMISSION_SCOPE=public
RUNBOOK_RAG_RERANK_ENABLED=true

# Multimodal evidence pipeline
RUNBOOK_MULTIMODAL_ENABLED=true
RUNBOOK_MULTIMODAL_COLLECT_DASHBOARDS=true
RUNBOOK_MULTIMODAL_USE_HERMES_VISION=false

# Benchmark / eval
RUNBOOK_EVAL_PERSIST_DEFAULT=false
RUNBOOK_EVAL_MODEL_ASSIST_ENABLED=false
RUNBOOK_EVAL_MODEL_ASSIST_WEIGHT=0.0

# Training / RL / AutoPipeline
RUNBOOK_TRAINING_ENABLED=true
RUNBOOK_TRAINING_DIR=.runbook_hermes_store/training
RUNBOOK_TRAINING_MAX_INCIDENTS=100
RUNBOOK_TRAINING_MIN_REWARD=0.65
RUNBOOK_TRAINING_COMPRESS_MAX_CHARS=6000
RUNBOOK_TRAINING_BASE_MODEL=Qwen/Qwen3-8B
# /training/pipeline/run is always isolated and never launches external jobs.
# Real launch requires the separate /training/external-launch endpoint plus all gates below.
RUNBOOK_TRAINING_EXTERNAL_LAUNCH_ENABLED=false
RUNBOOK_TRAINING_EXTERNAL_LAUNCH_TOKEN=
RUNBOOK_ALICLOUD_AUTOPIPELINE_ENABLED=false
RUNBOOK_ALICLOUD_AUTOPIPELINE_EXECUTE=false
RUNBOOK_ALICLOUD_OSS_URI=oss://<bucket>/runbook-aiops/training/
RUNBOOK_ALICLOUD_PAI_WORKSPACE=<workspace-id>
RUNBOOK_ALICLOUD_TRAINING_IMAGE=<pai-dlc-qwen-or-ms-swift-image>
